// Prisma schema for Jiji Deal Hunter
// Multi-market (Kenya, Nigeria, Ghana, Tanzania, Uganda) classifieds intelligence
// All fields below come from the actual /api_web/v1/* response shapes (verified via recon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Market {
  id          String   @id // "ke", "ng", "gh", "tz", "ug"
  name        String   // "Kenya"
  baseUrl     String   // "https://jiji.co.ke"
  apiPrefix   String   @default("/api_web/v1")
  enabled     Boolean  @default(true)
  lastCensusAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  Category[]
  listings    Listing[]
  sellers     Seller[]
  imageHashes ImageHash[]
}

model Category {
  id           String   @id // `${marketId}-${catId}` e.g. "ke-3"
  marketId     String
  market       Market   @relation(fields: [marketId], references: [id])
  catId        Int      // Jiji's numeric category ID (3 = cars in KE)
  slug         String
  name         String?
  listingCount Int      @default(0) // live count from categories_counts.json
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([marketId, catId])
  @@index([marketId])
}

model Seller {
  id              String   @id // `${marketId}-${numericUserId}`
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  numericUserId   Int      // Jiji's numeric user_id (cross-market stable)
  username        String
  location        String?
  accountAgeDays  Int      @default(0)
  totalListings   Int      @default(0) // from seller profile
  advertsCount    Int      @default(0) // total ads (dealer signal)
  feedbackCount   Int      @default(0) // from opinions endpoint
  rating          Float    @default(0)
  hidePhone       Boolean  @default(false)
  phoneLeaked     Boolean  @default(false)
  phone           String?  // public seller contact
  verifiedBadge   Boolean  @default(false)
  isDealer        Boolean  @default(false) // computed: advertsCount/feedbackCount > 50

  // Scout intelligence (from scout.jiji.co.ke — paid API, requires SCOUT_API_KEY)
  // These fields are null until the operator provides a Scout API key and runs
  // the Scout enrichment pass. See src/lib/scout-client.ts.
  nicheScore      Int?     // 0..100 — seller's market dominance per category
  categoryDominance Float? @default(0) // 0..1 — fraction of category this seller controls
  responseTimeHours Float?  // Scout's measured response time
  memberSinceYear  Int?    // Year the seller joined (from Scout profile)
  scoutEnrichedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listings        Listing[]
  imageHashes     ImageHash[]

  @@unique([marketId, numericUserId])
  @@index([marketId])
  @@index([numericUserId])
}

model Listing {
  id                String   @id // `${marketId}-${guid}`
  marketId          String
  market            Market   @relation(fields: [marketId], references: [id])
  guid              String   // Jiji's listing GUID
  title             String
  price             BigInt   // BigInt to handle large NGN/TZS prices (up to 9.9 trillion)
  currency          String   @default("KES")
  category          String   // slug
  categoryId       Int?
  condition         String   @default("new")
  location          String?
  imageUrl          String?
  imageCount        Int      @default(0)
  views             Int      @default(0) // count_views
  favCount         Int      @default(0) // fav_count
  daysOnMarket      Int      @default(0)
  url               String?

  // Scam-signal fields from recon
  status            String   @default("active") // status + status_color
  statusColor       String?
  dateCreated       DateTime?
  dateEdited        DateTime?  // churn signal
  dateModerated     DateTime?  // rapid re-moderation = scam
  soldReported      Boolean  @default(false) // ghost listing
  canMakeOffer      Boolean  @default(false)
  abuseReported    Boolean  @default(false) // previously flagged
  isBoost           Boolean  @default(false) // paid promotion
  paidInfo          String?  // JSON of paid_info
  availableTopsCount Int     @default(0) // commercial intent

  // Jiji's own market price valuation (free scam signal)
  priceValuationLow   BigInt?
  priceValuationHigh  BigInt?
  priceValuationLabel String?  // "below market" | "above market" | ...
  priceValuationUrl   String?  // round-trips filter state for verification

  // Relations
  sellerId          String
  seller            Seller   @relation(fields: [sellerId], references: [id])
  // Soft-delete + liveness tracking.
  // `deletedAt` is set by runCollection when a listing was NOT seen in the
  // current sweep — this is how we prune stale inventory without losing
  // historical price data (PriceHistory rows are preserved via onDelete: Cascade
  // but we filter `deletedAt == null` on every read).
  // `lastSeenAt` is bumped on every successful collection that included this
  // listing, enabling efficient "stale since" queries.
  deletedAt        DateTime?
  lastSeenAt       DateTime  @default(now())

  collectedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  priceHistory      PriceHistory[]
  dealScore         DealScore?
  imageHashes       ImageHash[]

  @@unique([marketId, guid])
  @@index([marketId])
  @@index([sellerId])
  @@index([category])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([lastSeenAt])
}

model PriceHistory {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price       BigInt   // BigInt to match Listing.price
  recordedAt  DateTime @default(now())

  @@index([listingId])
}

model DealScore {
  id                  String   @id @default(cuid())
  listingId           String   @unique
  listing             Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score               Float
  classification      String   // GREAT | FAIR | RISKY | SCAM
  priceVsMedian       Float
  sellerRisk          Float
  popularityRisk      Float
  priceManipulation   Float    @default(0)
  hasPhoneLeak        Boolean  @default(false)
  hasFakeDiscount     Boolean  @default(false)
  claimedDiscount     Float?
  realDiscount        Float?

  // New recon-derived signals
  editChurn24h        Boolean  @default(false)
  moderationChurn24h  Boolean  @default(false)
  isGhostListing      Boolean  @default(false)
  abuseFlagged        Boolean  @default(false)
  isBoosted           Boolean  @default(false)
  dealerRatio         Float    @default(0) // advertsCount / max(feedbackCount, 1)
  crossMarketBroker   Boolean  @default(false)
  imageDuplicateCount Int      @default(0) // same image hash across other listings
  relistCount         Int      @default(0) // same seller relisted same image

  factors             String   @default("{}") // JSON
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ImageHash {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id])
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  hash        String   // content hash (size-invariant)
  hashType    String   // "modern" | "legacy"
  url         String
  firstSeenAt DateTime @default(now())

  @@unique([marketId, listingId, hash])
  @@index([hash])
  @@index([sellerId])
  @@index([marketId, hash])
}

model CollectionRun {
  id              String   @id @default(cuid())
  marketId        String?  // null = all markets
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  sourceMode      String   @default("api") // api | browser
  itemsCollected  Int      @default(0)
  itemsUpdated    Int      @default(0)
  fakeDiscounts   Int      @default(0)
  scamsFlagged    Int      @default(0)
  status          String   @default("running") // running | completed | failed
  log             String   @default("")
}

model ProxyPool {
  id           String   @id @default(cuid())
  url          String   @unique
  isWorking    Boolean  @default(false)
  latencyMs    Int      @default(0)
  lastTestedAt DateTime?
  failCount    Int      @default(0)
  createdAt    DateTime @default(now())
}

model ModelArtifact {
  id           String   @id @default(cuid())
  name         String   @unique // "deal-scorer"
  version      Int      @default(1)
  algorithm    String   @default("xgboost") // xgboost | weighted-features
  filePath     String   // path to model file under /ml-models/
  trainingRows Int      @default(0)
  features     String   @default("[]") // JSON list of feature names
  metrics      String   @default("{}") // JSON of train/val metrics
  trainedAt    DateTime @default(now())
  active       Boolean  @default(true)

  @@index([name, active])
}

model CacheEntry {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String   // JSON-serialized payload
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

/**
 * Server-side mutable state (scheduler + liveApiStatus).
 *
 * Replaces the module-level mutable objects in scheduler.ts and jiji-client.ts.
 * Those broke under serverless / multi-instance deployments because each
 * instance had its own copy. Persisting here means all replicas see the same
 * scheduler state and live API status.
 *
 * Single-row table (id = "singleton") — enforced by app code.
 */
model ServerState {
  id              String   @id // always "singleton"
  // Scheduler
  schedulerEnabled     Boolean  @default(true)
  schedulerRunning    Boolean  @default(false)
  schedulerIntervalMs Int      @default(1800000)
  schedulerLastRunAt  DateTime?
  schedulerNextRunAt  DateTime?
  schedulerTotalRuns  Int      @default(0)
  schedulerLastSummary String  @default("{}") // JSON
  // Live API status
  liveApiLastMode      String   @default("live") // live | blocked | error
  liveApiLastCheckedAt DateTime?
  liveApiLastError     String?
  liveApiSuccessCount  Int      @default(0)
  liveApiFailureCount  Int      @default(0)
  // Mutability
  updatedAt            DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Temporal pipeline tables
// ---------------------------------------------------------------------------

/**
 * Price snapshot — one (item, price, timestamp) tuple.
 *
 * Renamed from WaybackHtmlExtract to reflect that this table now serves BOTH
 * archived Wayback captures AND live weekly revisits. The shape is identical
 * — only the data source differs (captureUrl tells you which).
 *
 * Multiple captures of the same item at different points in time let us
 * compute price_delta, days_listed, motivated_seller, etc.
 *
 * For backward compatibility with existing scripts that reference the old
 * Prisma model name, `WaybackHtmlExtract` is kept as an @@alias. New code
 * should use PriceSnapshot.
 */
model PriceSnapshot {
  id              String   @id @default(cuid())
  marketId        String   // "ke" | "ng" | "tz" | ...
  itemId          String   // Jiji's advert GUID (extracted from card link href)
  price           BigInt   // parsed from card text (KSh/NGN/TSh stripped)
  currency        String   @default("KES")
  categorySlug    String?  // category page slug this was found on
  captureTimestamp DateTime // Wayback capture timestamp OR live revisit time
  captureUrl      String?  // full Wayback URL OR live Jiji URL for provenance
  source          String   @default("wayback") // wayback | live
  pageTitle       String?  // title text from the card (entity-resolution sanity check)
  createdAt       DateTime @default(now())

  @@unique([marketId, itemId, captureTimestamp])
  @@index([marketId, itemId])
  @@index([marketId, captureTimestamp])
  @@index([itemId])
  @@index([source])
}

/**
 * Canonical items after entity resolution.
 * Collapses multiple PriceSnapshot rows (same itemId, different timestamps)
 * into a single record with a computed price time series.
 *
 * This is the temporal feature layer — enables the non-leaking
 * "motivated seller" target: price dropped >20% AND stayed listed >14d.
 */
model CanonicalItem {
  id              String   @id // `${marketId}-${itemId}`
  marketId        String
  itemId          String   // Jiji advert GUID
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  captureCount    Int      @default(0)
  daysListed      Int      @default(0) // lastSeenAt - firstSeenAt in days

  // Price time series (JSON array of {t, price} sorted ascending)
  priceHistory    String   @default("[]")
  firstPrice      BigInt?
  lastPrice       BigInt?
  priceDeltaPct   Float    @default(0) // (lastPrice - firstPrice) / firstPrice
  priceVolatility Float    @default(0) // stddev of price history (normalized)
  priceDropRate   Float    @default(0) // priceDeltaPct / daysListed (per-day)

  // Temporal target (non-leaking): computed from the time series, not from
  // any single snapshot feature. A model trained on last-snapshot features
  // cannot reconstruct this without the historical captures.
  motivatedSeller Boolean  @default(false)
  staleListing    Boolean  @default(false)
  flipOpportunity Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([marketId, itemId])
  @@index([marketId])
  @@index([motivatedSeller])
  @@index([staleListing])
}
