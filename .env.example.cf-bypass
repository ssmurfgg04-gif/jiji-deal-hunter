# Cloudflare Bypass — Environment Variables
#
# Copy these into your .env file. All optional — system works without them
# (just falls back to Tier 2 / Wayback archives).

# ─── Tier 1: FlareSolverr (self-hosted, FREE) ───────────────────────────
# URL of your FlareSolverr instance. Default works if you ran the docker-compose.
FLARESOLVERR_URL=http://localhost:8191/v1
# Max time to wait for FlareSolverr to solve a challenge (ms)
FLARESOLVERR_TIMEOUT_MS=60000

# ─── Tier 2: Spider.cloud (freemium, $1/GB) ─────────────────────────────
# Sign up: https://spider.cloud — free balance on signup, no card required.
# Without key, falls back to free no-key tier (rate-limited).
SPIDER_API_KEY=
SPIDER_TIMEOUT_MS=90000

# ─── Tier 3: CapSolver (paid, ~$1-3 per 1000 solves) ────────────────────
# Sign up: https://www.capsolver.com — use promo code "CURL" for +6% balance.
# Optional — only used when Tier 1 + Tier 2 both fail.
CAPSOLVER_API_KEY=
CAPSOLVER_MAX_WAIT_MS=120000

# ─── Existing (do not duplicate) ─────────────────────────────────────────
# DATABASE_URL — already in .env
# JIJI_REQUEST_DELAY_MS — already in .env (default 1200)
