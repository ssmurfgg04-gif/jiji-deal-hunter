# Cloudflare Bypass — Environment Variables
#
# Copy these into your .env file. All optional — system works without them
# (just falls back to Tier 5 / Wayback archives).
#
# ⚠️  NEVER commit your real .env file. The .env file is in .gitignore.
#     If you accidentally commit secrets, rotate them immediately:
#       1. Apify: https://console.apify.com/account#/integrations
#       2. Spider.cloud: https://spider.cloud/account
#       3. CapSolver: https://dashboard.capsolver.com/dashboard

# ─── Tier 1: FlareSolverr (self-hosted, FREE) ───────────────────────────
# URL of your FlareSolverr instance. Default works if you ran the docker-compose.
FLARESOLVERR_URL=http://localhost:8191/v1
# Max time to wait for FlareSolverr to solve a challenge (ms)
FLARESOLVERR_TIMEOUT_MS=60000

# ─── Tier 2: Apify Jiji Africa Scraper (FREE $5/mo credit) ─────────────
# Sign up: https://console.apify.com (FREE plan = $5/mo credit + residential proxies)
# Get API token: Account → Integrations → API tokens
# Get user ID: Account → Profile (it's in the URL after /account/)
# Get proxy password: Account → Proxy → "Password" field
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_USER_ID=xxxxxxxxxxxxxxxxx
APIFY_TIMEOUT_MS=120000
APIFY_PROXY_PASSWORD=apify_proxy_xxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Tier 3: Spider.cloud /unblocker (paid, $1/GB) ─────────────────────
# Sign up: https://spider.cloud
# IMPORTANT: Free tier does NOT cover /unblocker endpoint (returns 402).
# You must add credits at https://spider.cloud/credits/new
# Per SKILL.md: /unblocker is for bot-walled sites; /scrape is for plain pages.
SPIDER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPIDER_TIMEOUT_MS=90000

# ─── Tier 4: CapSolver (paid, ~$1-3 per 1000 solves) ───────────────────
# Sign up: https://www.capsolver.com — use promo code "CURL" for +6% balance.
# Optional — only used when Tier 1+2+3 all fail.
CAPSOLVER_API_KEY=
CAPSOLVER_MAX_WAIT_MS=120000

# ─── Existing (do not duplicate) ─────────────────────────────────────────
# DATABASE_URL — already in .env
# JIJI_REQUEST_DELAY_MS — already in .env (default 1200)
